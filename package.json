{
  "name": "jaysonsugpatanjs-hub.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:edge-dashboard": "node training/scripts/build-edge-dashboard-bundles.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "npm run build && node scripts/sync-pages-build.mjs",
    "preview": "vite preview",
    "test:training": "node --test training/tests/*.test.mjs && node --experimental-strip-types --test training/tests/*.test.ts",
    "validate:training-private": "node training/scripts/provision-supabase-module.mjs --dry-run training/ppt/pp-trn-wld-001",
    "check:training-public": "node training/scripts/check-public-training.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13"
  }
}
